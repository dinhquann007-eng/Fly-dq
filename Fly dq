--========================================================--
-- SPEED SLIDER
--========================================================--

local SpeedDragging = false

local function SetSpeed(X)
    local Width = Slider.AbsoluteSize.X
    if Width <= 0 then return end

    local Percent = math.clamp(
        (X - Slider.AbsolutePosition.X) / Width,
        0,
        1
    )

    Speed = math.clamp(math.floor(Percent * 1000 + 0.5), 1, 1000)
    SpeedLabel.Text = "FLY SPEED : " .. Speed
    Fill.Size = UDim2.new(Speed / 1000, 0, 1, 0)
    Knob.Position = UDim2.new(Speed / 1000, 0, 0.5, 0)
end

Slider.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then
        SpeedDragging = true
        SetSpeed(input.Position.X)
    end
end)

UIS.InputChanged:Connect(function(input)
    if SpeedDragging and (
        input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseMovement
    ) then
        SetSpeed(input.Position.X)
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then
        SpeedDragging = false
    end
end)

--========================================================--
-- STOP FLY
--========================================================--

local function StopFly()
    Flying = false
    Vertical = 0

    if FlyLoop then
        FlyLoop:Disconnect()
        FlyLoop = nil
    end

    if DeathConnection then
        DeathConnection:Disconnect()
        DeathConnection = nil
    end

    if FlyVelocity then FlyVelocity:Destroy(); FlyVelocity = nil end
    if FlyOrientation then FlyOrientation:Destroy(); FlyOrientation = nil end
    if FlyAttachment then FlyAttachment:Destroy(); FlyAttachment = nil end

    if Humanoid and Humanoid.Parent then
        Humanoid.AutoRotate = true
    end

    Toggle.Text = "FLY : OFF"
    Toggle.BackgroundColor3 = Color3.fromRGB(55, 55, 65)
    Status.Text = "STATUS: OFF"
    Status.TextColor3 = Color3.fromRGB(255, 70, 70)
    VerticalFrame.Visible = false
end

--========================================================--
-- START FLY
--========================================================--

local function StartFly()
    if Flying then return end

    GetCharacter()
    if not Humanoid or not Root then return end

    Flying = true
    Vertical = 0

    FlyAttachment = Instance.new("Attachment")
    FlyAttachment.Name = "DqSmoothFly_Attachment"
    FlyAttachment.Parent = Root

    FlyVelocity = Instance.new("LinearVelocity")
    FlyVelocity.Name = "DqSmoothFly_Velocity"
    FlyVelocity.Attachment0 = FlyAttachment
    FlyVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
    FlyVelocity.ForceLimitsEnabled = false
    FlyVelocity.VectorVelocity = Vector3.zero
    FlyVelocity.Parent = Root

    FlyOrientation = Instance.new("AlignOrientation")
    FlyOrientation.Name = "DqSmoothFly_Orientation"
    FlyOrientation.Attachment0 = FlyAttachment
    FlyOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
    FlyOrientation.RigidityEnabled = false
    FlyOrientation.Responsiveness = 25
    FlyOrientation.MaxTorque = math.huge
    FlyOrientation.Parent = Root

    Humanoid.AutoRotate = false
    Humanoid:ChangeState(Enum.HumanoidStateType.Freefall)

    Toggle.Text = "FLY : ON"
    Toggle.BackgroundColor3 = Color3.fromRGB(0, 170, 90)
    Status.Text = "STATUS: ON"
    Status.TextColor3 = Color3.fromRGB(70, 255, 120)
    VerticalFrame.Visible = UIS.TouchEnabled

    DeathConnection = Humanoid.Died:Connect(StopFly)

    FlyLoop = RunService.Heartbeat:Connect(function()
        if not Flying then return end

        if not Character or not Character.Parent
            or not Humanoid or Humanoid.Health <= 0
            or not Root or not Root.Parent then
            StopFly()
            return
        end

        local Camera = workspace.CurrentCamera
        if not Camera then return end

        local Move = Humanoid.MoveDirection
        local Direction = Vector3.zero

        if Move.Magnitude > 0.05 then
            Direction = Move.Unit
        else
            local Keyboard = Vector3.zero

            if UIS:IsKeyDown(Enum.KeyCode.W) then
                Keyboard += Camera.CFrame.LookVector
            end
            if UIS:IsKeyDown(Enum.KeyCode.S) then
                Keyboard -= Camera.CFrame.LookVector
            end
            if UIS:IsKeyDown(Enum.KeyCode.A) then
                Keyboard -= Camera.CFrame.RightVector
            end
            if UIS:IsKeyDown(Enum.KeyCode.D) then
                Keyboard += Camera.CFrame.RightVector
            end

            if Keyboard.Magnitude > 0.05 then
                Direction = Keyboard.Unit
            end
        end

        Direction += Vector3.new(0, Vertical, 0)

        if Direction.Magnitude > 0.01 then
            Direction = Direction.Unit * Speed
        else
            Direction = Vector3.zero
        end

        FlyVelocity.VectorVelocity = Direction

        local Look = Camera.CFrame.LookVector
        local FlatLook = Vector3.new(Look.X, 0, Look.Z)

        if FlatLook.Magnitude > 0.01 then
            FlyOrientation.CFrame = CFrame.lookAt(
                Vector3.zero,
                FlatLook.Unit
            )
        end
    end)
end

Toggle.Activated:Connect(function()
    if Flying then
        StopFly()
    else
        StartFly()
    end
end)

